      "data": {
        "key": "H2CK4IXG",
        "version": 9480,
        "itemType": "conferencePaper",
        "title": "OntoClue, a framework to compare vector-based approaches for document relatedness using the RELISH corpus",
        "creators": [
          {
            "creatorType": "author",
            "firstName": "Rohitha",
            "lastName": "Ravinder"
          },
          {
            "creatorType": "author",
            "firstName": "Tim",
            "lastName": "Fellerhoff"
          },
          {
            "creatorType": "author",
            "firstName": "Vishnu",
            "lastName": "Dadi"
          },
          {
