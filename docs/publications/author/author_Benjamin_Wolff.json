        "version": 3193,
        "itemType": "journalArticle",
        "title": "Evaluation Infrastructures for Academic Shared Tasks",
        "creators": [
          {
            "creatorType": "author",
            "firstName": "Johann",
            "lastName": "Schaible"
          },
          {
            "creatorType": "author",
            "firstName": "Timo",
            "lastName": "Breuer"
          },
          {
            "creatorType": "author",
            "firstName": "Narges",
            "lastName": "Tavakolpoursaleh"
