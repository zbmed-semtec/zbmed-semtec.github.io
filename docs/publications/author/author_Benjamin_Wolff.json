        "itemType": "preprint",
        "title": "Enriched BERT Embeddings for Scholarly Publication Classification",
        "creators": [
          {
            "creatorType": "author",
            "firstName": "Benjamin",
            "lastName": "Wolff"
          },
          {
            "creatorType": "author",
