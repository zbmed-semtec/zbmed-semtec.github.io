    "data": {
      "key": "TC2DL2KL",
      "version": 4258,
      "itemType": "conferencePaper",
      "title": "Living Labs for Academic Search at CLEF 2020",
      "creators": [
        {
          "creatorType": "author",
          "firstName": "Philipp",
          "lastName": "Schaer"
        },
        {
          "creatorType": "author",
          "firstName": "Johann",
          "lastName": "Schaible"
        },
        {
          "creatorType": "author",
          "firstName": "Bernd",
          "lastName": "Müller"
        },
        {
          "creatorType": "editor",
          "firstName": "Joemon M.",
          "lastName": "Jose"
        },
        {
          "creatorType": "editor",
          "firstName": "Emine",
          "lastName": "Yilmaz"
        },
        {
          "creatorType": "editor",
          "firstName": "João",
          "lastName": "Magalhães"
        },
        {
          "creatorType": "editor",
          "firstName": "Pablo",
          "lastName": "Castells"
        },
        {
          "creatorType": "editor",
          "firstName": "Nicola",
          "lastName": "Ferro"
        },
        {
          "creatorType": "editor",
          "firstName": "Mário J.",
          "lastName": "Silva"
        },
        {
          "creatorType": "editor",
          "firstName": "Flávio",
          "lastName": "Martins"
        }
      ],
      "abstractNote": "The need for innovation in the field of academic search and IR, in general, is shown by the stagnating system performance in controlled evaluation campaigns, as demonstrated in TREC and CLEF meta-evaluation studies, as well as user studies in real systems of scientific information and digital libraries. The question of what constitutes relevance in academic search is multi-layered and a topic that drives research communities for years. The Living Labs for Academic Search (LiLAS) workshop has the goal to inspire the discussion on research and evaluation of academic search systems by strengthening the concept of living labs to the domain of academic search. We want to bring together IR researchers interested in online evaluations of academic search systems and foster knowledge on improving the search for academic resources like literature, research data, and the interlinking between these resources. The employed online evaluation approach based on a living lab infrastructure allows the direct connection to real-world academic search systems from the life sciences and the social sciences.",
      "proceedingsTitle": "Advances in Information Retrieval",
      "conferenceName": "ECIR",
      "publisher": "Springer International Publishing",
