    "data": {
      "key": "6IRSFBTX",
      "version": 69,
      "itemType": "dataset",
      "title": "Datasets for OntoClue Project",
      "creators": [
        {
          "creatorType": "author",
          "firstName": "Rohitha",
          "lastName": "Ravinder"
        },
        {
          "creatorType": "author",
