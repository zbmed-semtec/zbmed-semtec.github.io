    "data": {
      "key": "AVW2QPQV",
      "version": 46,
      "itemType": "preprint",
      "title": "An assessment of Croissant ML metadata descriptors for AI-ready datasets",
      "creators": [
        {
          "creatorType": "author",
          "firstName": "Jerven",
          "lastName": "Bolleman"
        },
        {
          "creatorType": "author",
          "firstName": "Leyla Jael",
