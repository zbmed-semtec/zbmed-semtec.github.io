      "title": "Document-to-document relevant assessment for TREC Genomics Track 2005",
      "creators": [
        {
          "creatorType": "author",
          "firstName": "Olga",
          "lastName": "Giraldo"
        },
        {
          "creatorType": "author",
          "firstName": "Dhwani",
