      "key": "MXGJB33J",
      "version": 155,
      "itemType": "computerProgram",
      "title": "bert-embeddings-doc-relevance",
      "creators": [
        {
          "creatorType": "programmer",
          "firstName": "Rohitha",
          "lastName": "Ravinder"
        },
