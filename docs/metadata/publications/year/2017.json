    "data": {
      "key": "P46IIWSU",
      "version": 2708,
      "itemType": "conferencePaper",
      "title": "Life Science Ontologies in Literature Retrieval: A Comparison of Linked Data Sets for Use in Semantic Search on a Heterogeneous Corpus",
      "creators": [
        {
          "creatorType": "author",
          "firstName": "Bernd",
          "lastName": "Müller"
        },
        {
          "creatorType": "author",
          "firstName": "Alexandra",
